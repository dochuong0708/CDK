{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DeepGuard Agent (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.agent.cli",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "DEEPGUARD_DB_PATH": "${workspaceFolder}/data/deepguard.db",
        "OLLAMA_HOST": "http://localhost:11434",
        "DEEPGUARD_AGENT_MODEL": "qwen2.5:3b"
      },
      "preLaunchTask": "backend: install dependencies"
    }
  ]
}
