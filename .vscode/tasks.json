{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: install dependencies",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "runOptions": { "instanceLimit": 1, "instancePolicy": "silent" },
      "problemMatcher": []
    },
    {
      "label": "deepguard-agent: run",
      "type": "shell",
      "command": "python -m app.agent.cli",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "DEEPGUARD_DB_PATH": "${workspaceFolder}/data/deepguard.db",
        "OLLAMA_HOST": "http://localhost:11434",
        "DEEPGUARD_AGENT_MODEL": "qwen2.5:3b"
      },
      "problemMatcher": []
    },
    {
      "label": "detection-api: start backend",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "DEEPGUARD_DB_PATH": "${workspaceFolder}/data/deepguard.db",
        "DEEPGUARD_UPLOAD_DIR": "${workspaceFolder}/data/uploads"
      },
      "isBackground": true,
      "runOptions": { "instanceLimit": 1, "instancePolicy": "silent" },
      "problemMatcher": {
        "owner": "python",
        "severity": "info",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Application startup complete.*|.*Uvicorn running.*"
        }
      }
    },
    {
      "label": "backend: test",
      "type": "shell",
      "command": "python -m pytest",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
