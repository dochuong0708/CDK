{
  "name": "deepguard-local-debug",
  "private": true,
  "scripts": {
    "backend:dev": "cd backend && python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "frontend:dev": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "test:backend": "cd backend && python -m pytest",
    "test:frontend": "npm --prefix frontend run test",
    "debug:compose": "docker compose up -d"
  }
}
